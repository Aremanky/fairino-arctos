<!--
  FAIRINO FR5 + OrcaHand derecha + escena Elecnor. GENERADO por crear_fairino_mjcf.py
  a partir de arctos_mjcf.xml: solo cambia el brazo. Si tocáis la escena o la mano en
  arctos_mjcf.xml, volved a ejecutar el script.
-->
<mujoco model="fairino_fr5">
  <compiler angle="radian" autolimits="true"/>
  <option gravity="0 0 -9.81" integrator="implicitfast"/>

  <default>
    <joint armature="0.02" damping="3.0" frictionloss="0.1"/>
    <geom contype="0" conaffinity="0"/>                <!-- todo sin colisión por defecto -->
    <position kp="200" dampratio="1.0" ctrlrange="-3.14 3.14"/>

    <!-- Ajustes propios de la OrcaHand (copiados de orcahand_right.mjcf), en su propia clase
         para que no choquen con el <default> del brazo -->
    <default class="mano">
      <geom type="mesh" friction="1 0.005 0.001" condim="3" contype="1" conaffinity="1"/>
      <joint type="hinge" limited="true" damping="0.1" armature="0.001" margin="0.01" frictionloss="0.001"/>
      <position ctrllimited="true" forcelimited="true" forcerange="-1 1" kp="2.0"/>
    </default>
  </default>

