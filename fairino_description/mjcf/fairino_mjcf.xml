  <worldbody>
    <light pos="0 0 2" dir="0 0 -1"/>

    <!-- ══ PEANA DEL BRAZO ══════════════════════════════════════════════════════
         El brazo NO se ha movido: su base sigue en z = 0 (igual que antes). Lo que
         baja es el SUELO, ALTURA_PEANA = 0.70 m, y en el hueco va la peana.
         Así todo lo que usa coordenadas del mundo (taladro [4]/[5], mesa [3],
         PALMA_Z_MIN, CODO_Z_MIN, ARM_Z_MINIMA, techo automático...) sigue igual.
         El suelo y la peana NO chocan con nada (contype/conaffinity = 0), igual
         que el suelo de antes: son solo decorado.
         Para cambiar la altura de la peana, cambia las z marcadas con [H]
         (H = 0.70) y las patas de mesa_trabajo.xml si H pasa de ~1 m. -->
    <geom name="floor" type="plane" pos="0 0 -0.70" size="2 2 0.1" material="suelo_elecnor_material"/>  <!-- [H] -->

    <!-- ══ DECORADO CORPORATIVO: geoms estáticos, solo visuales (contype/conaffinity = 0) ══ -->
    <!-- Pared de fondo blanca: ahora baja hasta el nuevo suelo (de z = -0.70 a 1.35) -->
