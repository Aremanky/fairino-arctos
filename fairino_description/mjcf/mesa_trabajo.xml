<!--
  ENTORNO DE TRABAJO (tecla [3] de Skill_Shield_Nivel_6.py)
  ==========================================================
  Mini mesa de taller con: alicates, destornillador, bombilla y fusible, más
  una bandeja de piezas, un portalámparas y un portafusibles fijos en la mesa.

  Cómo se usa: se incluye desde arctos_mjcf.xml con UNA línea, puesta justo
  antes de </mujoco> (fuera de <worldbody>):

      <include file="mesa_trabajo.xml"/>

  y este archivo va en la MISMA carpeta que arctos_mjcf.xml.

  Todo empieza escondido bajo el suelo. El script lo coloca delante del brazo
  al pulsar [3] y lo vuelve a esconder al pulsar [3] otra vez. La posición de
  la mesa y de cada objeto se ajusta en Python (TALLER_POS_MESA y
  TALLER_OBJETOS), no hace falta tocar este archivo para moverlos.

  Convenciones:
    · Solo primitivas (y un mesh hexagonal definido aquí mismo), sin archivos STL.
    · Orientaciones con quat (w x y z), para no depender del angle="radian/degree"
      del <compiler> del archivo principal.
    · group="0" → geoms que chocan (el script los activa/desactiva).
      group="2" → geoms solo visuales (nunca chocan).
    · Todos los nombres empiezan por "taller_" para no chocar con el resto del modelo.
    · Objetos sueltos con condim="6" y rozamiento alto (deslizante, torsional y
      de rodadura) para que la mano pueda cogerlos sin que resbalen ni giren.
      MuJoCo usa el MAYOR rozamiento de los dos geoms en contacto, así que
      esto funciona sin tocar nada de la mano.
    · Origen de la mesa = centro de la superficie de trabajo (z = 0 es donde se
      apoyan las cosas).
-->
<mujoco model="mesa_trabajo">

  <asset>
    <material name="taller_madera"    rgba="0.62 0.45 0.28 1"  specular="0.2" shininess="0.2"/>
    <material name="taller_tapete"    rgba="0.18 0.30 0.36 1"  specular="0.05"/>
    <material name="taller_pata"      rgba="0.20 0.22 0.25 1"  specular="0.6" shininess="0.6"/>  <!-- grafito, como la peana del brazo -->
    <material name="taller_bandeja"   rgba="0.0 0.278 0.6 1"   specular="0.3"/>                 <!-- azul Elecnor -->
    <material name="taller_metal"     rgba="0.72 0.74 0.78 1"  specular="0.9" shininess="0.8" reflectance="0.1"/>
    <material name="taller_laton"     rgba="0.80 0.66 0.30 1"  specular="0.8" shininess="0.7"/>
    <material name="taller_negro"     rgba="0.08 0.08 0.09 1"  specular="0.3"/>
    <material name="taller_porcelana" rgba="0.93 0.92 0.88 1"  specular="0.5" shininess="0.5"/>
    <material name="taller_rojo"      rgba="0.80 0.10 0.10 1"  specular="0.2"/>
    <material name="taller_amarillo"  rgba="0.95 0.75 0.10 1"  specular="0.3"/>
    <material name="taller_vidrio"    rgba="1.00 0.98 0.85 0.45" specular="1" shininess="1"/>
    <material name="taller_gris"      rgba="0.45 0.46 0.48 1"  specular="0.3"/>

    <!-- Mango hexagonal del destornillador (prisma de 10 cm, radio 13 mm):
         con caras planas no rueda por la mesa como lo haría un cilindro. -->
    <mesh name="taller_mango_hex" vertex="
      -0.05  0.013   0        -0.05  0.0065  0.0112583  -0.05 -0.0065  0.0112583
      -0.05 -0.013   0        -0.05 -0.0065 -0.0112583  -0.05  0.0065 -0.0112583
       0.05  0.013   0         0.05  0.0065  0.0112583   0.05 -0.0065  0.0112583
       0.05 -0.013   0         0.05 -0.0065 -0.0112583   0.05  0.0065 -0.0112583"/>
  </asset>

  <worldbody>

    <!-- ═════════════ MESA (mocap: fija, la coloca el script) ═════════════ -->
    <body name="taller_mesa" mocap="true" pos="0 0 -10">
      <!-- Tablero 36 x 56 cm y tapete de trabajo encima -->
      <geom name="taller_tablero" type="box" pos="0 0 -0.014" size="0.18 0.28 0.012"
            material="taller_madera" group="0" contype="1" conaffinity="1" condim="4" friction="1 0.01 0.001"/>
      <geom name="taller_tapete" type="box" pos="0 0 -0.001" size="0.17 0.27 0.001"
            material="taller_tapete" group="0" contype="1" conaffinity="1" condim="4" friction="1 0.01 0.001"/>
      <!-- Patas (solo visuales, largas para que lleguen al suelo a cualquier altura).
           Alargadas a 1.1 m por la peana del brazo (suelo en z = -0.70): con la mesa a
           z = 0.10 hacen falta 0.80 m; lo que sobra queda escondido bajo el suelo. -->
      <geom name="taller_pata_1" type="box" pos=" 0.16  0.26 -0.576" size="0.015 0.015 0.55" material="taller_pata" group="2" contype="0" conaffinity="0"/>
      <geom name="taller_pata_2" type="box" pos=" 0.16 -0.26 -0.576" size="0.015 0.015 0.55" material="taller_pata" group="2" contype="0" conaffinity="0"/>
      <geom name="taller_pata_3" type="box" pos="-0.16  0.26 -0.576" size="0.015 0.015 0.55" material="taller_pata" group="2" contype="0" conaffinity="0"/>
      <geom name="taller_pata_4" type="box" pos="-0.16 -0.26 -0.576" size="0.015 0.015 0.55" material="taller_pata" group="2" contype="0" conaffinity="0"/>

      <!-- Bandeja de piezas (hueco interior 14.6 x 14 cm, paredes de 2.5 cm) -->
      <geom name="taller_bandeja_base" type="box" pos="0.08 0.15 0.0015" size="0.077 0.074 0.0015"
            material="taller_bandeja" group="0" contype="1" conaffinity="1" condim="4" friction="1 0.01 0.001"/>
      <geom name="taller_bandeja_p1" type="box" pos="0.005 0.15 0.0155" size="0.002 0.074 0.0125"
            material="taller_bandeja" group="0" contype="1" conaffinity="1" condim="4" friction="1 0.01 0.001"/>
      <geom name="taller_bandeja_p2" type="box" pos="0.155 0.15 0.0155" size="0.002 0.074 0.0125"
            material="taller_bandeja" group="0" contype="1" conaffinity="1" condim="4" friction="1 0.01 0.001"/>
      <geom name="taller_bandeja_p3" type="box" pos="0.08 0.078 0.0155" size="0.077 0.002 0.0125"
            material="taller_bandeja" group="0" contype="1" conaffinity="1" condim="4" friction="1 0.01 0.001"/>
      <geom name="taller_bandeja_p4" type="box" pos="0.08 0.222 0.0155" size="0.077 0.002 0.0125"
            material="taller_bandeja" group="0" contype="1" conaffinity="1" condim="4" friction="1 0.01 0.001"/>

      <!-- Portalámparas E27 (aquí se "enrosca" la bombilla) -->
      <geom name="taller_portalamp_base" type="cylinder" pos="0.09 -0.16 0.006" size="0.035 0.006"
            material="taller_negro" group="0" contype="1" conaffinity="1" condim="4" friction="1 0.01 0.001"/>
      <geom name="taller_portalamp_cuerpo" type="cylinder" pos="0.09 -0.16 0.027" size="0.02 0.015"
            material="taller_porcelana" group="0" contype="1" conaffinity="1" condim="4" friction="1 0.01 0.001"/>
      <geom name="taller_portalamp_aro" type="cylinder" pos="0.09 -0.16 0.043" size="0.017 0.001"
            material="taller_laton" group="0" contype="1" conaffinity="1" condim="4" friction="1 0.01 0.001"/>

      <!-- Portafusibles: base + dos cunas donde apoyan los casquillos del fusible -->
      <geom name="taller_portafus_base" type="box" pos="-0.07 -0.16 0.006" size="0.04 0.018 0.006"
            material="taller_gris" group="0" contype="1" conaffinity="1" condim="4" friction="1 0.01 0.001"/>
      <geom name="taller_portafus_c1" type="box" pos="-0.092 -0.1505 0.020" size="0.005 0.0025 0.008"
            material="taller_laton" group="0" contype="1" conaffinity="1" condim="4" friction="1 0.01 0.001"/>
      <geom name="taller_portafus_c2" type="box" pos="-0.092 -0.1695 0.020" size="0.005 0.0025 0.008"
            material="taller_laton" group="0" contype="1" conaffinity="1" condim="4" friction="1 0.01 0.001"/>
      <geom name="taller_portafus_c3" type="box" pos="-0.048 -0.1505 0.020" size="0.005 0.0025 0.008"
            material="taller_laton" group="0" contype="1" conaffinity="1" condim="4" friction="1 0.01 0.001"/>
      <geom name="taller_portafus_c4" type="box" pos="-0.048 -0.1695 0.020" size="0.005 0.0025 0.008"
            material="taller_laton" group="0" contype="1" conaffinity="1" condim="4" friction="1 0.01 0.001"/>

      <!-- Decoración corporativa Elecnor (canto, faldón, panel trasero). Solo visual:
           grupo 2, sin colisión ni masa → EntornoTaller no la toca. -->
      <include file="decoracion/deco_mesa.xml"/>
    </body>

    <!-- ═════════════ OBJETOS SUELTOS (se pueden coger) ═════════════ -->

    <!-- Alicates universales (~17 cm, 200 g). Cuerpo rígido: las mordazas no se abren. -->
    <body name="taller_alicates" pos="0.5 0 -10">
      <freejoint name="taller_alicates_joint"/>
      <inertial pos="-0.0268 0 0" mass="0.2" diaginertia="1.77e-05 0.000396 0.000411"/>
      <geom name="taller_alicates_mango1" type="capsule" fromto="-0.105 0.016 0 -0.025 0.007 0" size="0.0065"
            material="taller_rojo" group="0" contype="1" conaffinity="1" condim="6" friction="1.5 0.03 0.002"/>
      <geom name="taller_alicates_mango2" type="capsule" fromto="-0.105 -0.016 0 -0.025 -0.007 0" size="0.0065"
            material="taller_rojo" group="0" contype="1" conaffinity="1" condim="6" friction="1.5 0.03 0.002"/>
      <geom name="taller_alicates_eje" type="cylinder" pos="-0.012 0 0" size="0.010 0.0045"
            material="taller_metal" group="0" contype="1" conaffinity="1" condim="6" friction="1.1 0.03 0.002"/>
      <geom name="taller_alicates_cabeza" type="box" pos="0.012 0 0" size="0.022 0.0075 0.004"
            material="taller_metal" group="0" contype="1" conaffinity="1" condim="6" friction="1.1 0.03 0.002"/>
      <geom name="taller_alicates_punta" type="box" pos="0.045 0 0" size="0.012 0.0045 0.003"
            material="taller_metal" group="0" contype="1" conaffinity="1" condim="6" friction="1.1 0.03 0.002"/>
    </body>

    <!-- Destornillador de estrella (~21 cm, 70 g), eje a lo largo de X -->
    <body name="taller_destornillador" pos="1.0 0 -10">
      <freejoint name="taller_destornillador_joint"/>
      <inertial pos="0.0252 0 0" mass="0.07" diaginertia="4.24e-06 0.000215 0.000215"/>
      <geom name="taller_destornillador_mango" type="mesh" mesh="taller_mango_hex"
            material="taller_amarillo" group="0" contype="1" conaffinity="1" condim="6" friction="1.5 0.03 0.002"/>
      <geom name="taller_destornillador_tope" type="cylinder" fromto="-0.056 0 0 -0.05 0 0" size="0.011"
            material="taller_negro" group="0" contype="1" conaffinity="1" condim="6" friction="1.3 0.03 0.002"/>
      <geom name="taller_destornillador_virola" type="cylinder" fromto="0.05 0 0 0.058 0 0" size="0.007"
            material="taller_negro" group="0" contype="1" conaffinity="1" condim="6" friction="1.3 0.03 0.002"/>
      <geom name="taller_destornillador_varilla" type="cylinder" fromto="0.058 0 0 0.155 0 0" size="0.003"
            material="taller_metal" group="0" contype="1" conaffinity="1" condim="6" friction="1.1 0.03 0.002"/>
      <!-- Punta en cruz (Phillips): dos láminas cruzadas -->
      <geom name="taller_destornillador_punta1" type="box" pos="0.1575 0 0" size="0.0025 0.0028 0.0009"
            material="taller_metal" group="0" contype="1" conaffinity="1" condim="6" friction="1.1 0.03 0.002"/>
      <geom name="taller_destornillador_punta2" type="box" pos="0.1575 0 0" size="0.0025 0.0009 0.0028"
            material="taller_metal" group="0" contype="1" conaffinity="1" condim="6" friction="1.1 0.03 0.002"/>
    </body>

    <!-- Bombilla E27 (~10 cm, 32 g), eje a lo largo de X: -X = casquillo, +X = cristal -->
    <body name="taller_bombilla" pos="1.5 0 -10">
      <freejoint name="taller_bombilla_joint"/>
      <inertial pos="0.0164 0 0" mass="0.032" diaginertia="7.84e-06 2.52e-05 2.52e-05"/>
      <geom name="taller_bombilla_cristal" type="sphere" pos="0.036 0 0" size="0.03"
            material="taller_vidrio" group="0" contype="1" conaffinity="1" condim="6" friction="1.1 0.03 0.002"/>
      <geom name="taller_bombilla_cuello" type="cylinder" fromto="0 0 0 0.014 0 0" size="0.017"
            material="taller_vidrio" group="0" contype="1" conaffinity="1" condim="6" friction="1.1 0.03 0.002"/>
      <geom name="taller_bombilla_casquillo" type="cylinder" fromto="-0.024 0 0 0 0 0" size="0.0135"
            material="taller_metal" group="0" contype="1" conaffinity="1" condim="6" friction="1.1 0.03 0.002"/>
      <geom name="taller_bombilla_aislante" type="cylinder" fromto="-0.028 0 0 -0.024 0 0" size="0.009"
            material="taller_negro" group="0" contype="1" conaffinity="1" condim="6" friction="1.3 0.03 0.002"/>
      <geom name="taller_bombilla_contacto" type="cylinder" fromto="-0.030 0 0 -0.028 0 0" size="0.005"
            material="taller_laton" group="0" contype="1" conaffinity="1" condim="6" friction="1.1 0.03 0.002"/>
      <!-- Rosca del casquillo (solo visual) -->
      <geom name="taller_bombilla_rosca1" type="cylinder" fromto="-0.019 0 0 -0.017 0 0" size="0.0142"
            material="taller_metal" group="2" contype="0" conaffinity="0"/>
      <geom name="taller_bombilla_rosca2" type="cylinder" fromto="-0.013 0 0 -0.011 0 0" size="0.0142"
            material="taller_metal" group="2" contype="0" conaffinity="0"/>
      <geom name="taller_bombilla_rosca3" type="cylinder" fromto="-0.007 0 0 -0.005 0 0" size="0.0142"
            material="taller_metal" group="2" contype="0" conaffinity="0"/>
    </body>

    <!-- Fusible de cartucho 14x51 mm (12 g), eje a lo largo de X -->
    <body name="taller_fusible" pos="2.0 0 -10">
      <freejoint name="taller_fusible_joint"/>
      <inertial pos="0 0 0" mass="0.012" diaginertia="3.0e-07 3.11e-06 3.11e-06"/>
      <geom name="taller_fusible_cuerpo" type="cylinder" fromto="-0.019 0 0 0.019 0 0" size="0.007"
            material="taller_porcelana" group="0" contype="1" conaffinity="1" condim="6" friction="1.1 0.03 0.002"/>
      <geom name="taller_fusible_casq1" type="cylinder" fromto="-0.0255 0 0 -0.019 0 0" size="0.0072"
            material="taller_metal" group="0" contype="1" conaffinity="1" condim="6" friction="1.1 0.03 0.002"/>
      <geom name="taller_fusible_casq2" type="cylinder" fromto="0.019 0 0 0.0255 0 0" size="0.0072"
            material="taller_metal" group="0" contype="1" conaffinity="1" condim="6" friction="1.1 0.03 0.002"/>
      <!-- Indicador rojo de fusión (solo visual) -->
      <geom name="taller_fusible_indicador" type="box" pos="0 0 0.0066" size="0.006 0.003 0.0006"
            material="taller_rojo" group="2" contype="0" conaffinity="0"/>
    </body>

  </worldbody>
</mujoco>
