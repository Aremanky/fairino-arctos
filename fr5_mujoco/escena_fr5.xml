<mujoco model="escena_fr5">
  <include file="fr5.xml"/>

  <option timestep="0.002" gravity="0 0 -9.81"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3"/>
    <global azimuth="135" elevation="-25"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"/>
    <material name="grid" texture="grid" texrepeat="8 8" reflectance="0.1"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="suelo" type="plane" size="3 3 0.1" material="grid"/>
  </worldbody>

  <actuator>
    <position name="a_j1" joint="j1" kp="2000" ctrlrange="-3.0543 3.0543"/>
    <position name="a_j2" joint="j2" kp="2000" ctrlrange="-4.6251 1.4835"/>
    <position name="a_j3" joint="j3" kp="2000" ctrlrange="-2.8274 2.8274"/>
    <position name="a_j4" joint="j4" kp="500" ctrlrange="-4.6251 1.4835"/>
    <position name="a_j5" joint="j5" kp="500" ctrlrange="-3.0543 3.0543"/>
    <position name="a_j6" joint="j6" kp="500" ctrlrange="-3.0543 3.0543"/>
  </actuator>

  <!-- Con todo a 0 el FR5 queda estirado en horizontal (pose cero del fabricante).
       "listo": brazo arriba, antebrazo horizontal, herramienta mirando abajo.
       "vertical": brazo totalmente estirado hacia arriba. -->
  <keyframe>
    <key name="listo"    qpos="0 -1.5708 1.5708 0 0 0" ctrl="0 -1.5708 1.5708 0 0 0"/>
    <key name="vertical" qpos="0 -1.5708 0 0 0 0"      ctrl="0 -1.5708 0 0 0 0"/>
  </keyframe>
</mujoco>
